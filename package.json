{
  "name": "nkg-ages",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "archi": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "node e2e/smoke.mjs",
    "bench": "tsx scripts/bench-engine.ts",
    "bench:map": "node e2e/bench-map.mjs",
    "sonde": "tsx scripts/sonde.ts",
    "roadmap": "tsx scripts/roadmap.ts"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "~3.5.44"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "3.2.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright": "1.56.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.13"
  }
}
